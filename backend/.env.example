# Copy this file to backend/.env and fill in real values. Never commit .env.
#   macOS/Linux:  cp backend/.env.example backend/.env
#   PowerShell:   Copy-Item backend/.env.example backend/.env

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MongoDB Atlas → your cluster → Connect → Drivers → copy the mongodb+srv:// string.
# Replace <db_username> and <db_password> with the database user you created (not your Atlas login).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=sukoon_dev

# At least 32 random characters. Generate one with:
#   macOS/Linux:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   PowerShell:   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-value

# Absolute session lifetime (hours) and idle timeout (minutes)
SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=60

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Unsafe requests from any other origin are rejected as a CSRF protection.
# On Render, set to your static site URL — see deploy/render-link.env.example
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Address of the web app, used in emailed links (scheme + host, no trailing slash).
# Must be https:// in production (same host as CORS_ORIGINS in production).
APP_BASE_URL=http://localhost:5173

# How emails (verification, password reset) are sent:
#   console  - development only: the email, including its link, is printed in this terminal
#   smtp     - sent through your SMTP provider (fill in the SMTP_* settings below)
#   disabled - nothing is sent; reset requests answer "email temporarily unavailable"
# Production refuses to start with "console".
MAIL_TRANSPORT=console

# SMTP settings (only used when MAIL_TRANSPORT=smtp). Examples:
#   Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#                             SMTP_PASSWORD must be a 16-character "App password", not your login.
#   Zoho Mail (India):        SMTP_HOST=smtppro.zoho.in SMTP_PORT=465  SMTP_SECURE=true
#   Brevo / SendGrid / SES:   use the host, port 587 and SMTP key from the provider's dashboard.
# MAIL_FROM must be an address your provider allows you to send from.
# MAIL_FROM="Sukoon Health <no-reply@your-domain.in>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Keep true. Only set false for a local test inbox such as Mailpit (never in production).
# SMTP_REQUIRE_TLS=true

# Encrypts authenticator-app secrets (two-step verification) in the database.
# Optional in development (derived from SESSION_SECRET); required in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Keep it safe: losing it makes every enrolled authenticator unusable.
# MFA_ENCRYPTION_KEY=

# Online payments for paid appointments. With `disabled`, paid bookings show "Booking is paused".
#   sandbox  — local dev only: simulates Razorpay (no dashboard keys). Restart backend after change.
#   razorpay — real Razorpay Checkout; get TEST keys at https://dashboard.razorpay.com/app/keys
# Free (₹0) consultations work with any setting. Production refuses sandbox and test keys.
PAYMENT_PROVIDER=sandbox
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# Webhook secret you choose in Dashboard → Webhooks (URL: https://<api-host>/api/v1/webhooks/razorpay,
# events: payment.captured, payment.authorized, order.paid, refund.processed, refund.failed).
# Optional locally (Razorpay cannot reach localhost without a tunnel); required in production.
# RAZORPAY_WEBHOOK_SECRET=

# Video consultations inside the website (LiveKit Cloud). With "disabled", video slots are hidden.
# 1) Sign up at https://cloud.livekit.io (free tier is enough to try).
# 2) Create a project → Settings → Keys → Create key.
# 3) Copy: WebSocket URL (wss://….livekit.cloud), API key, API secret (secret shown once).
# 4) Paste below, set VIDEO_PROVIDER=livekit, restart backend (type `rs` in the backend terminal).
VIDEO_PROVIDER=disabled
# VIDEO_PROVIDER=livekit
# LIVEKIT_URL=wss://your-project-id.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Development only: allow joining video calls immediately after acceptance (until slot ends).
# VIDEO_JOIN_ANYTIME=true
# VIDEO_JOIN_EARLY_MINUTES=5

# Doctor-at-home booking (pilot PINs only). Leave false until dispatch is ready for patients.
# HOME_VISIT_BOOKING_OPEN=false

# Number of reverse proxies in front of the API (0 locally)
TRUST_PROXY_HOPS=0

# Per-IP requests per minute
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10

# Optional: fixed password for `npm run db:seed` demo accounts (min 12 characters)
# SEED_USER_PASSWORD=

# Owner's admin account, used once by `npm run admin:create -w backend`.
# Delete ADMIN_PASSWORD after running it. If the email already has an account, it is made an
# admin and its password is left unchanged. Editing ADMIN_FULL_NAME later does nothing until you
# run the script again, which then renames the existing account.
# ADMIN_EMAIL=you@example.com
# ADMIN_FULL_NAME=Your Name
# ADMIN_PASSWORD=
