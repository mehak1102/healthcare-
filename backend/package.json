{
  "name": "@sukoon/backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:nest": "nest start",
    "dev": "node scripts/dev.mjs",
    "dev:stop": "node scripts/dev-stop.mjs",
    "start:dev": "nodemon",
    "start:prod": "node dist/main",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --runInBand",
    "db:indexes": "nest build && node dist/scripts/sync-indexes.js",
    "db:seed": "nest build && node dist/scripts/seed-dev.js",
    "db:seed:remove": "nest build && node dist/scripts/seed-dev.js --remove",
    "db:seed:demo-doctor": "nest build && node dist/scripts/seed-bookable-demo-doctor.js",
    "db:seed:demo-doctor:instant": "SEED_DEMO_INSTANT_CONFIRM=true nest build && SEED_DEMO_INSTANT_CONFIRM=true node dist/scripts/seed-bookable-demo-doctor.js",
    "db:seed:demo-doctor:paid": "SEED_DEMO_PAID=true nest build && SEED_DEMO_PAID=true node dist/scripts/seed-bookable-demo-doctor.js",
    "db:seed:demo-doctor:video": "SEED_DEMO_VIDEO=true nest build && SEED_DEMO_VIDEO=true node dist/scripts/seed-bookable-demo-doctor.js",
    "admin:create": "nest build && node dist/scripts/create-admin.js",
    "db:refresh-next-available": "nest build && node dist/scripts/refresh-next-available-dates.js",
    "check:production-env": "nest build && node dist/scripts/check-production-env.js",
    "db:seed-public-holidays": "nest build && node dist/scripts/seed-public-holidays.js",
    "db:seed-service-areas": "nest build && node dist/scripts/seed-service-areas.js"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "node_modules/.cache/mongodb-binaries"
    }
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "es-toolkit": "^1.52.0",
    "helmet": "^8.3.0",
    "livekit-server-sdk": "^2.19.1",
    "mongoose": "^9.11.2",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@types/jest": "^30.0.0",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "oxlint": "^1.87.0",
    "pino-pretty": "^13.2.0",
    "smtp-server": "^3.19.21",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14"
  }
}
