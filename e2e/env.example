# Copy to your shell before npm run test:browser (do not commit real passwords).
#
#   export E2E_PATIENT_PASSWORD='your-demo-password'
#   npm run test:browser
#
# Use the same password as seed:
#   SEED_USER_PASSWORD='your-demo-password' npm run db:seed -w backend
#
# E2E_PATIENT_EMAIL=patient.demo@sukoon.test
# E2E_ADMIN_EMAIL=admin.demo@sukoon.test
# E2E_DOCTOR_EMAIL=doctor.demo@sukoon.test
# E2E_DOCTOR_SLUG=dr-demo-doctor-abc   # optional; written by db:seed:demo-doctor
# E2E_BASE_URL=http://localhost:5173
# E2E_API_URL=http://localhost:3000
#
# One-time setup:
#   SEED_USER_PASSWORD='…' npm run db:seed -w backend
#   npm run db:seed:demo-doctor -w backend          # free + doctor must accept (default)
#   npm run db:seed:demo-doctor:instant -w backend  # free + instant confirm
#   npm run db:seed:demo-doctor:paid -w backend     # ₹500 + sandbox pay (needs PAYMENT_PROVIDER=sandbox)
#   npm run db:seed:demo-doctor:video -w backend    # video + doctor accept (needs LiveKit in backend/.env)
