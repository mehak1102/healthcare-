# Copy to frontend/.env.local for local overrides (optional).
# On Render, set this in the Static Site → Environment (build-time).
# Production pairing with the API: see deploy/render-link.env.example

# Full API base including /api/v1 — no trailing slash.
# Example: https://sukoon-api.onrender.com/api/v1
VITE_API_BASE_URL=
